# For GitHub Pages project sites, e.g. VITE_BASE_PATH=/repo-name/
VITE_BASE_PATH=/

# Supabase (optional). The browser bundle only receives variables whose names start with VITE_.
# Use these exact names, then restart `npm run dev` (or rebuild for production).
#
#   VITE_SUPABASE_URL=https://xxxx.supabase.co
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# If you already use Supabase CLI defaults (SUPABASE_URL / SUPABASE_ANON_KEY), those are
# also mapped in vite.config.ts — but the anon key must be the *anon* public key, not the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
